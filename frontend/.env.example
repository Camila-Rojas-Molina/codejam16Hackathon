# Copy to .env.local and fill in. Never commit .env.local.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud > Map Management) for a custom map style. Empty = Google's demo map ID.
VITE_GOOGLE_MAPS_MAP_ID=
# Map engine: maplibre (default: 3D map on OpenFreeMap tiles, no key) or google. If the 3D map
# can't start (no WebGL, tiles unreachable) the app falls back to Google (with a key) or a list.
VITE_MAP_ENGINE=

# Supabase backend (Project Settings > API). Leave empty to use mock data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
