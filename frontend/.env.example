# Copy to .env.local and fill in. Never commit .env.local.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud > Map Management) for a custom map style. Empty = Google's demo map ID.
VITE_GOOGLE_MAPS_MAP_ID=

# Supabase backend (Project Settings > API). Leave empty to use mock data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
