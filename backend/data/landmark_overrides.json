  "name_rules": [
    {"_comment": "Applied in order to kept records (after the type mapping); first match wins. Case-insensitive, on the NFC name.",
     "regex": "^(l['’]\\s*)?(église|eglise|basilique|cathédrale|chapelle|oratoire|temple|synagogue|mosquée|monastère|couvent|sanctuaire|presbytère)\\b", "category": "religious"},
    {"regex": "^(belvédère|observatoire|l['’]observatoire)\\b", "category": "viewpoint"},
    {"regex": "^(musée|pointe-à-callière|centre d['’]histoire)\\b", "category": "museum"},
    {"regex": "^cimetière\\b", "category": "historic"}
  ],
  "required": [
